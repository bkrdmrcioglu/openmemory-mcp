DATABASE_URL=postgres://openmemory:openmemory@localhost:5432/openmemory
# stdio (local tools spawn the process) or http (self-hosted network service)
TRANSPORT=stdio
PORT=3333
# Bearer token required on /mcp when set (recommended for http mode)
OPENMEMORY_TOKEN=
# Optional: real embeddings. Without it a local hashing fallback is used.
OPENAI_API_KEY=
