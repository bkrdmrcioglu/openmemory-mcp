DATABASE_URL=postgres://openmemory:openmemory@localhost:5432/openmemory
# stdio (local tools spawn the process) or http (self-hosted network service)
TRANSPORT=stdio
PORT=3333
# Access token for /mcp, /api and the web UI. Required in http mode.
OPENMEMORY_TOKEN=
# Set to true only to run http mode without a token on a trusted network.
OPENMEMORY_ALLOW_NO_AUTH=false
# Optional: real embeddings. Without it a local hashing fallback is used.
OPENAI_API_KEY=
